# Copy this file to .env in this target directory; Compose loads it automatically.
# Exported shell variables override values in .env.
# HF_TOKEN=hf_example
# HF_HUB_DISABLE_IMPLICIT_TOKEN=1
# HF_CACHE_DIR=/home/user/.cache/huggingface
# SGLANG_BASE_IMAGE=lmsysorg/sglang:dev-qwen38-27b-dflash2
# SGLANG_PORT=30000
# CONTEXT_LENGTH=32768
# MEM_FRACTION_STATIC=0.45
# MAX_RUNNING_REQUESTS=4
# MAX_MAMBA_CACHE_SIZE=16
# CHUNKED_PREFILL_SIZE=2048

# Extra whitespace-separated flags appended to SGLang's launch_server command.
# --enable-metrics exposes Prometheus metrics at /metrics on SGLANG_PORT.
# Generation services report output token counts and tokens/second; embedding
# services process input tokens and do not generate text output tokens.
# Append other flags here as needed; set an empty value to disable metrics for
# direct infer serve/deploy. make start always enables metrics automatically.
# Rerun infer serve for this model/engine/target after changing this value;
# applying it to a running service recreates the container and reloads the model.
SGLANG_EXTRA_ARGS="--enable-metrics"

# Optional native MTP speculative decoding using the same FP8 checkpoint.
# Startup and text API smoke checks passed with the pinned image and defaults.
# Adds draft/verification memory and reduces KV capacity; benchmark your workload.
# SGLANG_EXTRA_ARGS="--enable-metrics --speculative-algorithm EAGLE --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4"
# Higher concurrency also requires matching scheduler, Mamba, and graph limits.
# See the model README's Throughput Capacity section for measured dedicated-host settings.
