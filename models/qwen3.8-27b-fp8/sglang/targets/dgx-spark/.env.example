# MEM_FRACTION_STATIC=0.45
# MAX_RUNNING_REQUESTS=4
# MAX_MAMBA_CACHE_SIZE=16
# CHUNKED_PREFILL_SIZE=2048
# SGLANG_EXTRA_ARGS=
