# Copy this file to .env in this target directory; Compose loads it automatically.
# Exported shell variables override values in .env.
# Optional for this public model; recommended to avoid anonymous rate limits.
HF_TOKEN=

# Ignore a stale cached login for public reads. Set to 0 with a valid HF_TOKEN
# when authenticated access is required.
HF_HUB_DISABLE_IMPLICIT_TOKEN=1

# The model cache survives container recreation.
HF_CACHE_DIR=${HOME}/.cache/huggingface

# The 26.02 image is already cached on the development DGX Spark.
NVIDIA_PYTORCH_IMAGE=nvcr.io/nvidia/pytorch:26.02-py3
SGLANG_VERSION=0.5.15.post1
SGLANG_EXCLUDE_NEWER=2026-07-15T00:00:00Z

SGLANG_PORT=30000
CONTEXT_LENGTH=32768
GPU_MEMORY_BUDGET_GIB=60

# Advanced override: bypass the GiB-to-fraction calculation.
MEM_FRACTION_STATIC=

# FlashInfer compiles large FP4 kernels on first startup. Bound concurrency on
# unified-memory DGX Spark systems so compiler workers do not exhaust memory.
MAX_JOBS=4

# Extra whitespace-separated flags appended to SGLang's launch_server command.
# --enable-metrics exposes Prometheus metrics at /metrics on SGLANG_PORT.
# Generation services report output token counts and tokens/second; embedding
# services process input tokens and do not generate text output tokens.
# Append other flags here as needed; set an empty value to disable metrics.
# Rerun infer serve for this model/engine/target after changing this value;
# applying it to a running service recreates the container and reloads the model.
SGLANG_EXTRA_ARGS="--enable-metrics"
