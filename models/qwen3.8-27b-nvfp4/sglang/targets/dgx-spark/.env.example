# Copy this file to .env in this target directory; Compose loads it automatically.
# Exported shell variables override values in .env.
# HF_TOKEN=hf_example
# HF_HUB_DISABLE_IMPLICIT_TOKEN=1
# HF_CACHE_DIR=/home/user/.cache/huggingface
# SGLANG_BASE_IMAGE=lmsysorg/sglang:dev-qwen38-27b-dflash2
# SGLANG_PORT=30000
# CONTEXT_LENGTH=32768
# MEM_FRACTION_STATIC=0.70
# MAX_RUNNING_REQUESTS=72
# CHUNKED_PREFILL_SIZE=2048
# MAX_MAMBA_CACHE_SIZE=360

# Extra whitespace-separated flags appended to SGLang's launch command.
SGLANG_EXTRA_ARGS="--enable-metrics"
