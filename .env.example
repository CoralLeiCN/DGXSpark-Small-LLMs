# Copy to .env and fill in local values before using docker compose.
# Optional: set this if the Hugging Face model requires gated/private access.
# HF_TOKEN=hf_your_token_here

# Optional overrides.
VLLM_IMAGE=nvcr.io/nvidia/vllm:26.05-py3
VLLM_PORT=8000
HF_CACHE_DIR=${HOME}/.cache/huggingface

# Nano v3 requires this parser file next to docker-compose.yml by default.
NANO_REASONING_PARSER_PATH=./nano_v3_reasoning_parser.py
NANO_SERVED_MODEL_NAME=model
NANO_MAX_NUM_SEQS=8
NANO_MAX_MODEL_LEN=262144

# Super profile overrides.
SUPER_SERVED_MODEL_NAME=nemotron-3-super
TENSOR_PARALLEL_SIZE=1
PIPELINE_PARALLEL_SIZE=1
DATA_PARALLEL_SIZE=1
GPU_MEMORY_UTILIZATION=0.90
MAX_NUM_SEQS=4
MAX_MODEL_LEN=394000
