# Copy to .env in this directory; Docker Compose loads it automatically.
# Choose a unique password before starting Grafana. Applies on first database
# initialization only; change an existing account's password through Grafana.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Loopback access by default. Use an SSH tunnel from another machine, or set a
# specific trusted LAN address to publish there. Prometheus has no login here.
MONITORING_BIND_ADDRESS=127.0.0.1
# Override Grafana separately with this host's Tailscale IPv4 address for remote
# access within your tailnet. Grafana login stays required.
# Leave unset to inherit MONITORING_BIND_ADDRESS. Prometheus keeps its own bind.
# GRAFANA_BIND_ADDRESS=100.x.y.z
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Dev and prod share retention and storage in this single monitoring stack.
PROMETHEUS_RETENTION=30d
